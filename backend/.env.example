# LendWise configuration. Copy to backend/.env and set GROQ_API_KEY.

# --- LLM (Groq: free key at https://console.groq.com/keys) ---
GROQ_API_KEY=
# LLM_MODE=fake runs a scripted offline AI (no key, no network). Decisions are identical: they are made by code.
LLM_MODE=groq
MODEL_ROUTER=qwen/qwen3.8-27b
MODEL_FAST=openai/gpt-oss-20b
MODEL_LARGE=openai/gpt-oss-120b
MODEL_TOKENS_PER_MINUTE=8000

# --- App ---
ENVIRONMENT=development
# Leave empty locally: a random secret is generated in backend/.secrets/. Set a 32+ char secret in production.
JWT_SECRET=
BOOTSTRAP_ADMIN_EMAIL=admin@lendwise.dev
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026
ALLOW_REGISTRATION=true

# --- Lending ---
# Offers above this amount need a second approver (four-eyes)
FOUR_EYES_AMOUNT=1000000
MAX_STATEMENT_MB=3
APPLICATIONS_PER_USER_PER_DAY=5

LOG_FORMAT=text
LOG_FILE=
